{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/crine-in/all-religious-texts/main/schemas/verse.schema.json",
  "title": "Verse",
  "description": "Universal JSON Schema for a single verse or text unit in the ART ecosystem.",
  "type": "object",
  "required": [
    "id",
    "externalId",
    "religion",
    "collection",
    "book",
    "chapter",
    "verse",
    "citation",
    "language",
    "script",
    "text",
    "license",
    "source"
  ],
  "properties": {
    "id": { "type": "string" },
    "externalId": { "type": "integer", "minimum": 1 },
    "religion": { "type": "string" },
    "collection": { "type": "string" },
    "book": { "type": "string" },
    "canto": { "type": ["integer", "null"] },
    "chapter": { "type": "integer", "minimum": 0 },
    "section": { "type": ["integer", "null"] },
    "verse": { "type": "integer", "minimum": 0 },
    "subVerse": { "type": ["integer", "null"] },
    "citation": { "type": "string" },
    "language": { "type": "string" },
    "script": { "type": "string" },
    "text": { "type": "string" },
    "license": { "type": "string" },
    "source": { "type": "string" },
    "attribution": { "type": ["string", "null"] },
    "translator": { "type": ["string", "null"] },
    "edition": { "type": ["string", "null"] },
    "footnotes": { "type": "array", "items": { "type": "string" } },
    "crossReferences": { "type": "array", "items": { "type": "string" } },
    "keywords": { "type": "array", "items": { "type": "string" } },
    "checksum": { "type": ["string", "null"] },
    "lastUpdated": { "type": ["string", "null"] }
  },
  "additionalProperties": false
}
